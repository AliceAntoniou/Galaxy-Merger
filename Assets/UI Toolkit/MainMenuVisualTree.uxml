<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=1522a85c41276f347917f093d15cac59&amp;type=3#MainMenuStyle"/>
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-image: url(&quot;project://database/Assets/Assets/Sprites/Main%20Menu%20Temp%20Background.png?fileID=2800000&amp;guid=184260b4f5a22704ca1f926d38966ef2&amp;type=3#Main Menu Temp Background&quot;);">
        <ui:Label text="Galaxy Merger" name="Title" class="header" style="font-size: 100px; -unity-text-align: upper-center; background-color: rgba(0, 0, 0, 0);"/>
        <ui:Button text="Play" name="PlayButton" class="button" style="width: 280px; height: 60px; -unity-text-align: middle-center; font-size: 20px;"/>
        <ui:Button text="Settings" name="SettingsButton" class="button" style="width: 280px; height: 60px; font-size: 20px;"/>
        <ui:Button text="Quit" name="ExitButton" class="button" style="height: 60px; width: 280px; font-size: 20px;"/>
    </ui:VisualElement>
</ui:UXML>
